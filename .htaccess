RewriteEngine On
RewriteBase /

# Redirect root index to canonical home URL
RewriteCond %{THE_REQUEST} \s/index\.html[\?\s] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Redirect old page authoring URLs to clean URLs
RewriteCond %{THE_REQUEST} \s/AHM_Website/pages/services/index\.html[\?\s] [NC]
RewriteRule ^AHM_Website/pages/services/index\.html$ /services [R=301,L]
RewriteCond %{THE_REQUEST} \s/AHM_Website/pages/solutions/index\.html[\?\s] [NC]
RewriteRule ^AHM_Website/pages/solutions/index\.html$ /solutions [R=301,L]
RewriteCond %{THE_REQUEST} \s/AHM_Website/pages/about/index\.html[\?\s] [NC]
RewriteRule ^AHM_Website/pages/about/index\.html$ /about [R=301,L]
RewriteCond %{THE_REQUEST} \s/AHM_Website/pages/contact/index\.html[\?\s] [NC]
RewriteRule ^AHM_Website/pages/contact/index\.html$ /contact [R=301,L]
RewriteCond %{THE_REQUEST} \s/AHM_Website/pages/consultation/index\.html[\?\s] [NC]
RewriteRule ^AHM_Website/pages/consultation/index\.html$ /consultation [R=301,L]
RewriteCond %{THE_REQUEST} \s/AHM_Website/pages/partners/index\.html[\?\s] [NC]
RewriteRule ^AHM_Website/pages/partners/index\.html$ /partners [R=301,L]
RewriteCond %{THE_REQUEST} \s/AHM_Website/pages/careers/index\.html[\?\s] [NC]
RewriteRule ^AHM_Website/pages/careers/index\.html$ /careers [R=301,L]
RewriteCond %{THE_REQUEST} \s/AHM_Website/pages/feedback/index\.html[\?\s] [NC]
RewriteRule ^AHM_Website/pages/feedback/index\.html$ /feedback [R=301,L]
RewriteCond %{THE_REQUEST} \s/AHM_Website/pages/legal/privacy\.html[\?\s] [NC]
RewriteRule ^AHM_Website/pages/legal/privacy\.html$ /privacy [R=301,L]
RewriteCond %{THE_REQUEST} \s/AHM_Website/pages/services/informatica\.html[\?\s] [NC]
RewriteRule ^AHM_Website/pages/services/informatica\.html$ /services/informatica [R=301,L]
RewriteCond %{THE_REQUEST} \s/AHM_Website/pages/services/snowflake\.html[\?\s] [NC]
RewriteRule ^AHM_Website/pages/services/snowflake\.html$ /services/snowflake [R=301,L]
RewriteCond %{THE_REQUEST} \s/AHM_Website/pages/services/python-ai\.html[\?\s] [NC]
RewriteRule ^AHM_Website/pages/services/python-ai\.html$ /services/python-ai [R=301,L]
RewriteCond %{THE_REQUEST} \s/AHM_Website/pages/services/web-development\.html[\?\s] [NC]
RewriteRule ^AHM_Website/pages/services/web-development\.html$ /services/web-development [R=301,L]
RewriteCond %{THE_REQUEST} \s/AHM_Website/pages/services/data-profiling\.html[\?\s] [NC]
RewriteRule ^AHM_Website/pages/services/data-profiling\.html$ /services/data-profiling [R=301,L]

# Internal rewrite clean URLs to authoring files
RewriteRule ^services/?$ /AHM_Website/pages/services/index.html [L]
RewriteRule ^solutions/?$ /AHM_Website/pages/solutions/index.html [L]
RewriteRule ^about/?$ /AHM_Website/pages/about/index.html [L]
RewriteRule ^contact/?$ /AHM_Website/pages/contact/index.html [L]
RewriteRule ^consultation/?$ /AHM_Website/pages/consultation/index.html [L]
RewriteRule ^partners/?$ /AHM_Website/pages/partners/index.html [L]
RewriteRule ^careers/?$ /AHM_Website/pages/careers/index.html [L]
RewriteRule ^feedback/?$ /AHM_Website/pages/feedback/index.html [L]
RewriteRule ^privacy/?$ /AHM_Website/pages/legal/privacy.html [L]
RewriteRule ^services/informatica/?$ /AHM_Website/pages/services/informatica.html [L]
RewriteRule ^services/snowflake/?$ /AHM_Website/pages/services/snowflake.html [L]
RewriteRule ^services/python-ai/?$ /AHM_Website/pages/services/python-ai.html [L]
RewriteRule ^services/web-development/?$ /AHM_Website/pages/services/web-development.html [L]
RewriteRule ^services/data-profiling/?$ /AHM_Website/pages/services/data-profiling.html [L]
